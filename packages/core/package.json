{
  "name": "@kernelfall/core",
  "version": "0.0.0",
  "private": true,
  "description": "What every package shares: the event bus, the logger, service responses and their error handler, storage keys, validation.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./services": "./src/services/index.ts"
  },
  "imports": {
    "#config": "./src/config.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#services/*": "./src/services/*.ts",
    "#test/*": "./src/test/*.ts",
    "#types/*": "./src/types/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  }
}
