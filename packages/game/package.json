{
  "name": "@kernelfall/game",
  "version": "0.0.0",
  "private": true,
  "description": "The game rules: levels, the level loop, checkers, Taint, hints, skills, saves and the Codex.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./utils": "./src/utils/index.ts",
    "./services": "./src/services/index.ts",
    "./store": "./src/store/index.ts",
    "./events": "./src/events/index.ts"
  },
  "imports": {
    "#config": "./src/config.ts",
    "#events/*": "./src/events/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#services/*": "./src/services/*.ts",
    "#store/*": "./src/store/*.ts",
    "#test/*": "./src/test/*.ts",
    "#types/*": "./src/types/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@kernelfall/core": "workspace:*",
    "@kernelfall/machine": "workspace:*",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  }
}
