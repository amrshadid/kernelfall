{
  "name": "@kernelfall/theme",
  "version": "0.0.0",
  "private": true,
  "description": "Kernelfall's Section 2 design tokens as plain values: palettes, type, rules, motion and colour maths.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./palettes": "./src/palettes/index.ts",
    "./typography": "./src/typography/index.ts",
    "./spacing": "./src/spacing/index.ts",
    "./motion": "./src/motion/index.ts",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "imports": {
    "#config": "./src/config.ts",
    "#theme": "./src/theme.ts",
    "#motion/*": "./src/motion/*.ts",
    "#palettes/*": "./src/palettes/*.ts",
    "#spacing/*": "./src/spacing/*.ts",
    "#types/*": "./src/types/*.ts",
    "#typography/*": "./src/typography/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
